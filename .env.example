# Environment configuration for Contract Compliance Drift & Redline Drafter
# Copy this file to .env and adjust values as needed.

# Path to the directory containing policy/contract PDF documents.
# Defaults to ./policy relative to the project root if not set.
POLICY_DIR=./policy

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional Gemini configuration. Never commit a real API key.
# The default model is gemini-2.5-flash; replace it with a Gemini model
# available to your Google AI Studio project if needed.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Gemini's OpenAI-compatible chat-completions endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Persistent workflow and frontend origins
DATABASE_PATH=./data/analyses.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
